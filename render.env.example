# =============================================================================
#  CampusConnect — Render environment variables (ready to paste)
#
#  Render → your service → Environment → "Add from .env" → paste all of this.
#  Then replace the 7 values in <ANGLE-BRACKETS>. Nothing else needs editing.
#
#  Where the four "secret" ones come from:
#    <DB-PASSWORD>          Supabase → Settings → Database → Reset password
#    <SERVICE-ROLE-KEY>     Supabase → Settings → API → service_role
#    <SMTP-...>             your mail provider (Gmail app password, Brevo, Resend)
#    <YOUR-VERCEL-URL>      the URL Vercel gives you, e.g. https://campusconnect.vercel.app
#  JWT_SECRET and OTP_PEPPER: use Render's "Generate" button on each row.
# =============================================================================

# --- runtime ----------------------------------------------------------------
NODE_ENV=production
NODE_VERSION=22
LOG_LEVEL=info

# --- database: Supabase "Session pooler" ------------------------------------
# Project: campusconnect  (ref byrcyboghrxxrunhzqts, ap-south-1 / Mumbai)
# Confirm the host and port by copying the string from Supabase → Connect →
# Session pooler. Use the POOLER, never the direct db.<ref>.supabase.co host:
# that one is IPv6-only and Render dials IPv4.
DATABASE_URL=postgresql://postgres.byrcyboghrxxrunhzqts:<DB-PASSWORD>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_SSL=true
DATABASE_POOL_MAX=10

# --- secrets (Render can generate both) -------------------------------------
JWT_SECRET=<CLICK-GENERATE>
OTP_PEPPER=<CLICK-GENERATE>

# --- sessions and hashing ---------------------------------------------------
JWT_EXPIRES_IN=12h
SESSION_TTL_HOURS=12
BCRYPT_ROUNDS=12

# --- who may register (confirmed with the university) ----------------------
ALLOWED_EMAIL_DOMAINS=saiuniversity.edu.in
REQUIRE_EMAIL_DOMAIN=true

# --- one-time codes ---------------------------------------------------------
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=6
PASSWORD_RESET_TTL_MINUTES=30

# --- listings ---------------------------------------------------------------
ITEM_EXPIRY_DAYS=60
ITEM_EXPIRY_WARN_DAYS=7

# --- public URLs (must be the VERCEL url, not the Render one) --------------
APP_URL=<YOUR-VERCEL-URL>
CORS_ORIGINS=<YOUR-VERCEL-URL>
TRUST_PROXY=1

# --- email: required, the API will not boot without it ---------------------
# Gmail:  smtp.gmail.com     465 true   + a 16-character App Password
# Brevo:  smtp-relay.brevo.com 587 false
# Resend: smtp.resend.com    465 true   user "resend", password = API key
MAIL_TRANSPORT=smtp
MAIL_FROM=CampusConnect <no-reply@saiuniversity.edu.in>
SMTP_HOST=<SMTP-HOST>
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=<SMTP-USER>
SMTP_PASS=<SMTP-PASSWORD>

# --- image storage (Supabase, already created) ------------------------------
STORAGE_DRIVER=supabase
SUPABASE_URL=https://byrcyboghrxxrunhzqts.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<SERVICE-ROLE-KEY>
SUPABASE_BUCKET_PUBLIC=item-images
SUPABASE_BUCKET_PRIVATE=claim-evidence
MAX_UPLOAD_MB=5

# --- rate limits (defaults are fine) ---------------------------------------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=600
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_OTP_MAX=10
RATE_LIMIT_WRITE_MAX=60
