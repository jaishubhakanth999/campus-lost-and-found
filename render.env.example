# =============================================================================
#  CampusConnect — Render environment variables
#
#  Paste this whole block into Render → your service → Environment →
#  "Add from .env". Then replace every <...> placeholder.
#
#  Two values are secrets you generate — Render can do it for you: click
#  "Generate" next to the value box, or run locally:  openssl rand -hex 32
# =============================================================================

# --- runtime ----------------------------------------------------------------
NODE_ENV=production
# Render resolves ">=20" in package.json to the newest major (it chose Node 26).
# Pin it. 20 and 22 are the versions CI tests.
NODE_VERSION=22
LOG_LEVEL=info

# --- database (Supabase → Connect → "Session pooler") -----------------------
# Host: aws-0-<region>.pooler.supabase.com   Port: 5432
# User: postgres.<project-ref>               Password: your database password
# Use the POOLER, not the direct host: direct is IPv6-only and Render dials IPv4.
DATABASE_URL=postgresql://postgres.<project-ref>:<database-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_SSL=true
DATABASE_POOL_MAX=10

# --- secrets (generate; never reuse across deployments) ---------------------
JWT_SECRET=<generate-32-bytes-hex>
OTP_PEPPER=<generate-32-bytes-hex>

# --- sessions and hashing ---------------------------------------------------
JWT_EXPIRES_IN=12h
SESSION_TTL_HOURS=12
BCRYPT_ROUNDS=12

# --- who may register -------------------------------------------------------
# Confirmed with the university. The parent domain also covers sub-domains
# such as scds.saiuniversity.edu.in.
ALLOWED_EMAIL_DOMAINS=saiuniversity.edu.in
REQUIRE_EMAIL_DOMAIN=true

# --- one-time codes ---------------------------------------------------------
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=6
PASSWORD_RESET_TTL_MINUTES=30

# --- listings ---------------------------------------------------------------
ITEM_EXPIRY_DAYS=60
ITEM_EXPIRY_WARN_DAYS=7

# --- public URLs (Vercel) ---------------------------------------------------
# APP_URL is what the links inside OTP / reset / claim emails point at.
APP_URL=https://<your-project>.vercel.app
CORS_ORIGINS=https://<your-project>.vercel.app
TRUST_PROXY=1

# --- email (required to boot: every sign-in needs an OTP) -------------------
# Gmail: smtp.gmail.com 465 true  + an App Password (not your login password)
# Brevo: smtp-relay.brevo.com 587 false
# Resend: smtp.resend.com 465 true, user "resend", password = API key
MAIL_TRANSPORT=smtp
MAIL_FROM=CampusConnect <no-reply@saiuniversity.edu.in>
SMTP_HOST=<smtp host>
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=<smtp username>
SMTP_PASS=<smtp password or app password>

# --- image storage (Render's disk is ephemeral: keep this as supabase) ------
STORAGE_DRIVER=supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role key>
SUPABASE_BUCKET_PUBLIC=item-images
SUPABASE_BUCKET_PRIVATE=claim-evidence
MAX_UPLOAD_MB=5

# --- rate limits (per 15 minutes; defaults are fine) ------------------------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=600
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_OTP_MAX=10
RATE_LIMIT_WRITE_MAX=60
