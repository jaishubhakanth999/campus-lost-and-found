# ---------------------------------------------------------------------------
# CampusConnect — environment example
# Copy to .env for local development. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# --- runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Public URL of the site. In production this MUST be https — email links and
# the CSP are built from it.
APP_URL=http://localhost:3000

# --- database (Supabase Postgres) ------------------------------------------
# Supabase dashboard → Project Settings → Database → Connection string → URI
# Use the "Connection pooling / Transaction" string for serverless hosts,
# or the direct connection string for a long-running server.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_SSL=true
DATABASE_POOL_MAX=10

# --- sessions and tokens ---------------------------------------------------
# openssl rand -hex 32
JWT_SECRET=replace_with_64_hex_characters_from_openssl_rand_hex_32
JWT_EXPIRES_IN=12h
SESSION_TTL_HOURS=72

# --- university email restriction ------------------------------------------
# CONFIRM THE OFFICIAL DOMAIN WITH SAI UNIVERSITY BEFORE ENABLING PRODUCTION.
# Comma-separated. Sub-domains are matched automatically, so
# "saiuniversity.edu.in" also allows "student@scds.saiuniversity.edu.in".
ALLOWED_EMAIL_DOMAINS=your-university.edu.in
# Optional: restrict administrator sign-in to a narrower domain. Defaults to
# the list above when left empty.
ALLOWED_ADMIN_EMAIL_DOMAINS=
REQUIRE_EMAIL_DOMAIN=true

# --- OTP -------------------------------------------------------------------
# openssl rand -hex 32   (a separate secret from JWT_SECRET)
OTP_PEPPER=replace_with_64_hex_characters_from_openssl_rand_hex_32
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=6

# --- email delivery --------------------------------------------------------
# smtp   = production (real delivery)
# file   = development (writes .html files to MAIL_OUTBOX_DIR so you can read
#          the code without it ever appearing in the console or logs)
# capture= tests only
MAIL_TRANSPORT=file
MAIL_FROM="CampusConnect <no-reply@your-university.edu.in>"
MAIL_OUTBOX_DIR=tmp/mail-outbox
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# --- image storage ---------------------------------------------------------
# local    = ./uploads (development only; the disk is ephemeral on most hosts)
# supabase = Supabase Storage (required for production)
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_PUBLIC=item-images
SUPABASE_BUCKET_PRIVATE=claim-evidence

# --- http hardening --------------------------------------------------------
# Comma-separated list of allowed browser origins when the frontend is hosted
# separately (e.g. Vercel). Leave empty for same-origin deployments.
CORS_ORIGINS=
# 1 when running behind one reverse proxy (Render, Vercel, Nginx).
TRUST_PROXY=1
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=600
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_OTP_MAX=10
RATE_LIMIT_WRITE_MAX=60
LOG_LEVEL=info
